#!/usr/bin/env python3

import os
import sys
import shutil
import subprocess
import re

PEERS_DIR = "{{ __wireguard_root_dir_peer_conf }}"
WG_INTERFACE = "{{ __wireguard_interface }}"
WG_CONFIG_NAME = "{{ __wireguard_name_internal_config }}"

def check_prerequisites():
    if os.geteuid() != 0:
        print("Error: This script must be run as root.", file=sys.stderr)
        sys.exit(1)

    if not os.path.isdir(PEERS_DIR):
        print(f"Error: Peers directory '{PEERS_DIR}' does not exist.", file=sys.stderr)
        sys.exit(1)

def get_peers():
    peers = []
    for entry in os.listdir(PEERS_DIR):
        if os.path.isdir(os.path.join(PEERS_DIR, entry)):
            peers.append(entry)
    
    peers.sort()

    if not peers:
        print(f"No peers found in '{PEERS_DIR}'.")
        sys.exit(0)

    return peers

def remove_peer(peer_id):
    peer_path = os.path.join(PEERS_DIR, peer_id)
    config_file = os.path.join(peer_path, WG_CONFIG_NAME)
    pubkey = None

    if os.path.isfile(config_file):
        try:
            with open(config_file, 'r') as f:
                for line in f:
                    match = re.match(r'(?i)^PublicKey\s*=\s*(.+)', line.strip())
                    if match:
                        pubkey = match.group(1).replace(' ', '')
                        break
        except Exception as e:
            print(f"Warning: Could not read config file: {e}", file=sys.stderr)
    wg_show_success = False
    try:
        result = subprocess.run(
            ["wg", "show", WG_INTERFACE], 
            stdout=subprocess.DEVNULL, 
            stderr=subprocess.DEVNULL
        )
        wg_show_success = (result.returncode == 0)
    except FileNotFoundError:
        pass

    if pubkey and wg_show_success:
        print(f"Removing peer from active WireGuard interface ({WG_INTERFACE})...")
        subprocess.run(["wg", "set", WG_INTERFACE, "peer", pubkey, "remove"])
    else:
        print(f"Warning: Live interface '{WG_INTERFACE}' is down or public key not found. Skipping live removal.")

    try:
        shutil.rmtree(peer_path)
        print(f"Success: Peer '{peer_id}' has been completely removed.")
    except Exception as e:
        print(f"Error: Failed to remove peer directory: {e}", file=sys.stderr)

def menu(peers):
    print("Please select a peer to remove:")
    options = peers + ["Exit"]
    
    for i, option in enumerate(options, 1):
        print(f"{i}) {option}")

    while True:
        try:
            choice = input("#? ")
            choice_idx = int(choice) - 1
            
            if 0 <= choice_idx < len(options):
                selected = options[choice_idx]
                
                if selected == "Exit":
                    print("Exiting without making any changes.")
                    sys.exit(0)
                else:
                    confirm = input(f"Are you sure you want to permanently delete peer '{selected}'? [y/N]: ")
                    if confirm.strip().lower() in ['y', 'yes']:
                        remove_peer(selected)
                    else:
                        print("Operation aborted by user.")
                    break
            else:
                print("Invalid option. Please enter a valid number from the list.")
        except ValueError:
            print("Invalid option. Please enter a valid number from the list.")
        except (KeyboardInterrupt, EOFError):
            print("\nExiting without making any changes.")
            sys.exit(0)

def main():
    check_prerequisites()
    peers = get_peers()
    menu(peers)

if __name__ == "__main__":
    main()